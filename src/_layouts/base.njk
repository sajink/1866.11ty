<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta property="og:image" content="/images/featured_img.jpeg" data-addsearch="no_crop">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="author" content="{{ site.author }}">
    <meta name="robots" content="index,follow">
    <link rel="stylesheet" href="{{ '/css/tw.min.css' | url }}">  
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Baskervville&family=Fraunces:ital,opsz@0,9..144;1,9..144&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz@0,9..144;1,9..144&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css" />
    <link rel="icon" type="image/png" href="/images/favicon.png">
  </head>
  <body class="text-base md:text-lg text-gray-800 font-baskervville">
    {% if site.isParked %}
    <div class="flex flex-col text-center bg-white h-screen text-black p-10">
      <p class="text-2xl font-bold">Site is Parked</p>
      <p>For more information, please contact Polika</p> 
      <a class="text-[#00F] hover:underline" href="tel:+918050640555">+91 8050 640 555</a>
      <a class="text-[#00F] hover:underline" href="mailto:hello@polika.net">hello@polika.net</a>
    </div>
    {% else %}
      {{ content | safe }}
      {% include "footer.html" %}
    {% endif %}
    <script src="/main.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"></script>
  </body>
</html>
